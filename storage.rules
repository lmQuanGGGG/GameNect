rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Mentor media: authenticated users can upload to their own folder
    match /mentor_media/{userId}/{allPaths=**} {
      // Anyone authenticated can read
      allow read: if request.auth != null;
      // Only the mentor themselves can write/delete (relaxed write check to debug uid mismatch)
      allow write: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // User avatars and profile photos (stored in users directory)
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024; // max 10MB
    }
    
    // General uploads (existing)
    match /uploads/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024;
    }
    
    // Posts/moments media
    match /moments/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 50 * 1024 * 1024;
    }

    // Chat media (images, videos, voice)
    match /chat_images/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /chat_videos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /voice_messages/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Default: deny all
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
